(decl partial SimplifyConvert (Link) Link)

;; IntegerNarrow(IntegerWiden(x)) => x
(rule 4
	(SimplifyConvert
		(IntegerNarrow (IntegerWiden x))
	)

	x
)

;; IntegerSignExtend(IntegerSignExtend(x, k), k) => IntegerSignExtend(x, k)
(rule 3
	(SimplifyConvert
		(SignExtendIdempotent inner)
	)

	inner
)

;; IntegerTransmuteToNumber(NumberTransmuteToInteger(x)) => x
(rule 2
	(SimplifyConvert
		(TransmuteIntRoundTrip x)
	)

	x
)

;; NumberTransmuteToInteger(IntegerTransmuteToNumber(x)) => x
(rule 1
	(SimplifyConvert
		(TransmuteNumberRoundTrip x)
	)

	x
)
