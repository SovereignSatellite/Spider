(decl ReduceI32Table (Link i32 i32) Link)

(rule 40 (ReduceI32Table predicate on_false on_true)
	(if-let 1 (raw_exclusive_or_i32 on_false on_true))
	(IntegerBinaryOperation
		predicate
		(I32 on_false)
		(IntegerType.I32)
		(IntegerBinaryOperator.ExclusiveOr)
	)
)

(rule 30 (ReduceI32Table predicate on_false on_true)
	(if-let 1 (raw_sub_i32 on_true on_false))
	(IntegerBinaryOperation
		predicate
		(I32 on_false)
		(IntegerType.I32)
		(IntegerBinaryOperator.Add)
	)
)

(rule 30 (ReduceI32Table predicate on_false on_true)
	(if-let -1 (raw_sub_i32 on_true on_false))
	(IntegerBinaryOperation
		(I32 on_false)
		predicate
		(IntegerType.I32)
		(IntegerBinaryOperator.Subtract)
	)
)

(rule 10 (ReduceI32Table predicate on_false on_true)
	(if-let difference (raw_exclusive_or_i32 on_false on_true))
	(IntegerBinaryOperation
		(IntegerBinaryOperation
			(IntegerBinaryOperation
				(I32 0)
				predicate
				(IntegerType.I32)
				(IntegerBinaryOperator.Subtract)
			)
			(I32 difference)
			(IntegerType.I32)
			(IntegerBinaryOperator.And)
		)
		(I32 on_false)
		(IntegerType.I32)
		(IntegerBinaryOperator.ExclusiveOr)
	)
)

