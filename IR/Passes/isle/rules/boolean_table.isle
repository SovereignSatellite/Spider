(type I32TableReduction
	(enum
		(ExclusiveOr (constant i32))
		(Increment (constant i32))
		(Decrement (constant i32))
		(Mask (constant i32) (difference i32))
	)
)

(decl pure partial SelectI32TableReduction (i32 i32) I32TableReduction)

(rule 40 (SelectI32TableReduction on_false on_true)
	(if-let true (OptimizationEnabled (Optimization.ReduceI32TruthTableWithXor)))
	(if-let 1 (EvaluateI32Binary (IntegerBinaryOperator.ExclusiveOr) on_false on_true))
	(I32TableReduction.ExclusiveOr on_false)
)

(rule 30 (SelectI32TableReduction on_false on_true)
	(if-let true (OptimizationEnabled (Optimization.ReduceI32TruthTableWithIncrement)))
	(if-let 1 (EvaluateI32Binary (IntegerBinaryOperator.Subtract) on_true on_false))
	(I32TableReduction.Increment on_false)
)

(rule 30 (SelectI32TableReduction on_false on_true)
	(if-let true (OptimizationEnabled (Optimization.ReduceI32TruthTableWithDecrement)))
	(if-let -1 (EvaluateI32Binary (IntegerBinaryOperator.Subtract) on_true on_false))
	(I32TableReduction.Decrement on_false)
)

(rule 10 (SelectI32TableReduction on_false on_true)
	(if-let true (OptimizationEnabled (Optimization.ReduceI32TruthTableWithMask)))
	(if-let difference (EvaluateI32Binary (IntegerBinaryOperator.ExclusiveOr) on_false on_true))
	(I32TableReduction.Mask on_false difference)
)

(decl BuildI32TableReduction (Link I32TableReduction) Link)

(rule (BuildI32TableReduction predicate (I32TableReduction.ExclusiveOr constant))
	(IntegerBinaryOperation
		predicate
		(I32 constant)
		(IntegerType.I32)
		(IntegerBinaryOperator.ExclusiveOr)
	)
)

(rule (BuildI32TableReduction predicate (I32TableReduction.Increment constant))
	(IntegerBinaryOperation
		predicate
		(I32 constant)
		(IntegerType.I32)
		(IntegerBinaryOperator.Add)
	)
)

(rule (BuildI32TableReduction predicate (I32TableReduction.Decrement constant))
	(IntegerBinaryOperation
		(I32 constant)
		predicate
		(IntegerType.I32)
		(IntegerBinaryOperator.Subtract)
	)
)

(rule (BuildI32TableReduction predicate (I32TableReduction.Mask constant difference))
	(IntegerBinaryOperation
		(IntegerBinaryOperation
			(IntegerBinaryOperation
				(I32 0)
				predicate
				(IntegerType.I32)
				(IntegerBinaryOperator.Subtract)
			)
			(I32 difference)
			(IntegerType.I32)
			(IntegerBinaryOperator.And)
		)
		(I32 constant)
		(IntegerType.I32)
		(IntegerBinaryOperator.ExclusiveOr)
	)
)

(decl partial ReduceI32Table (Link i32 i32) Link)

(rule (ReduceI32Table predicate on_false on_true)
	(if-let reduction (SelectI32TableReduction on_false on_true))
	(BuildI32TableReduction predicate reduction)
)

