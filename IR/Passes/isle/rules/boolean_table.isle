		(IntegerBinaryOperation
			(IntegerBinaryOperation
				(I64 0)
				(IntegerWiden predicate)
				(IntegerType.I64)
				(IntegerBinaryOperator.Subtract)
			)
			(I64 difference)
			(IntegerType.I64)
			(IntegerBinaryOperator.And)
		)
		(I64 constant)
		(IntegerType.I64)
