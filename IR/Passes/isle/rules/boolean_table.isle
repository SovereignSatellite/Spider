(decl BuildI64TableReduction (Link I64TableReduction) Link)

(rule (BuildI64TableReduction predicate (I64TableReduction.ExclusiveOr constant))
	(IntegerBinaryOperation
		(IntegerWiden predicate)
		(I64 constant)
		(IntegerType.I64)
		(IntegerBinaryOperator.ExclusiveOr)
	)
)

(rule (BuildI64TableReduction predicate (I64TableReduction.Increment constant))
