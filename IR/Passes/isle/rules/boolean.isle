(decl partial SimplifyBoolean (Link) Link)

(rule 31
	(SimplifyBoolean
		(IntegerCompareOperation
			(IntegerWiden boolean @ (ExactBoolean _))
			(I64 0)
			(IntegerType.I64)
			(IntegerCompareOperator.Equal)
		)
	)
	(if-let true (DirectComplementBooleanEnabled boolean))

	(DirectComplementBoolean boolean)
)

(rule 30
