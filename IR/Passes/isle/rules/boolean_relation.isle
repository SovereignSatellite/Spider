(rule 70 (ReduceBooleanBinaryPair left right operator)
	(if-let relation @ (IntegerRelation.Relation _ _ _ left_table right_table)
		(DescribeIntegerRelation left right))
	(if-let result (EvaluateI32BinaryTable5 operator left_table right_table))
	(ProjectIntegerI32 relation result)
)

(rule 60 (ReduceBooleanBinaryPair left right operator)
	(if-let relation @ (NumberRelation.Relation _ _ _ left_table right_table)
		(DescribeNumberRelation left right))
	(if-let result (EvaluateI32BinaryTable4 operator left_table right_table))
