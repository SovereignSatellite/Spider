(type I32Table4
	(enum
		(Table (less i32) (equal i32) (greater i32) (unordered i32))
	)
)

(type I64Table4
	(enum
		(Table (less i64) (equal i64) (greater i64) (unordered i64))
	)
)

(type I32Table5
	(enum
		(Table
			(equal i32)
			(less i32)
			(greater i32)
			(negative_left i32)
			(negative_right i32)
		)
	)
)

(type I64Table5
	(enum
		(Table
			(equal i64)
			(less i64)
			(greater i64)
			(negative_left i64)
			(negative_right i64)
		)
	)
)

(type IntegerRelation
	(enum
		(Relation
			(left Link)
			(right Link)
			(kind IntegerType)
			(left_table I32Table5)
			(right_table I32Table5)
		)
	)
)

(type NumberDefinition
	(enum
		(Definition
			(left Link)
			(right Link)
			(kind NumberType)
			(table I32Table4)
		)
	)
)

(type NumberRelation
	(enum
		(Relation
			(left Link)
			(right Link)
			(kind NumberType)
			(left_table I32Table4)
			(right_table I32Table4)
		)
	)
)

(type NumberPredicate
	(enum
		(Direct (operator NumberCompareOperator))
		(Reversed (operator NumberCompareOperator))
	)
)

(decl pure IntegerComparisonTable (IntegerCompareOperator) I32Table5)

(rule (IntegerComparisonTable operator)
	(I32Table5.Table
		(EvaluateI32Comparison operator 0 0)
		(EvaluateI32Comparison operator 0 1)
		(EvaluateI32Comparison operator 1 0)
		(EvaluateI32Comparison operator -1 0)
		(EvaluateI32Comparison operator 0 -1)
	)
)

(decl pure NumberComparisonTable (NumberCompareOperator) I32Table4)

(rule (NumberComparisonTable (NumberCompareOperator.Equal))
	(I32Table4.Table 0 1 0 0)
)

(rule (NumberComparisonTable (NumberCompareOperator.NotEqual))
	(I32Table4.Table 1 0 1 1)
)

(rule (NumberComparisonTable (NumberCompareOperator.LessThan))
	(I32Table4.Table 1 0 0 0)
)

(rule (NumberComparisonTable (NumberCompareOperator.LessThanEqual))
	(I32Table4.Table 1 1 0 0)
)

(decl pure partial DescribeIntegerRelation (Link Link) IntegerRelation)

(rule 20 (DescribeIntegerRelation
		(IntegerCompareOperation left right kind left_operator)
		(IntegerCompareOperation left right kind right_operator))
	(IntegerRelation.Relation
		left right kind
		(IntegerComparisonTable left_operator)
		(IntegerComparisonTable right_operator))
)

(rule 10 (DescribeIntegerRelation
		(IntegerCompareOperation left right kind left_operator)
		(IntegerCompareOperation right left kind right_operator))
	(if-let (I32Table5.Table equal less greater negative_left negative_right)
		(IntegerComparisonTable right_operator))
	(IntegerRelation.Relation
		left right kind
		(IntegerComparisonTable left_operator)
		(I32Table5.Table equal greater less negative_right negative_left))
)

(decl pure partial DescribeNumberDefinition (Link) NumberDefinition)

(rule 20 (DescribeNumberDefinition
		(NumberCompareOperation left right kind operator))
	(NumberDefinition.Definition
		left right kind (NumberComparisonTable operator))
)

(rule 10 (DescribeNumberDefinition
		(BooleanNot (NumberCompareOperation left right kind operator)))
	(if-let (I32Table4.Table less equal greater unordered)
		(NumberComparisonTable operator))
	(NumberDefinition.Definition
		left right kind
		(I32Table4.Table
			(EvaluateI32Binary (IntegerBinaryOperator.Subtract) 1 less)
			(EvaluateI32Binary (IntegerBinaryOperator.Subtract) 1 equal)
			(EvaluateI32Binary (IntegerBinaryOperator.Subtract) 1 greater)
			(EvaluateI32Binary (IntegerBinaryOperator.Subtract) 1 unordered)))
)

(decl pure partial DescribeNumberRelation (Link Link) NumberRelation)

(rule 20 (DescribeNumberRelation left_expression right_expression)
	(if-let (NumberDefinition.Definition comparison_left comparison_right kind left_table)
		(DescribeNumberDefinition left_expression))
	(if-let (NumberDefinition.Definition comparison_left comparison_right kind right_table)
		(DescribeNumberDefinition right_expression))
	(NumberRelation.Relation comparison_left comparison_right kind left_table right_table)
)

(rule 10 (DescribeNumberRelation left_expression right_expression)
	(if-let (NumberDefinition.Definition comparison_left comparison_right kind left_table)
		(DescribeNumberDefinition left_expression))
	(if-let (NumberDefinition.Definition
		comparison_right comparison_left kind
		(I32Table4.Table less equal greater unordered))
		(DescribeNumberDefinition right_expression))
	(NumberRelation.Relation
		comparison_left comparison_right kind left_table
		(I32Table4.Table greater equal less unordered))
)

