(decl partial SimplifyFloat (Link) Link)

(rule
	(SimplifyFloat
		(NumberUnaryOperation
			(NumberUnaryOperation source type (NumberUnaryOperator.Negate))
			type
			(NumberUnaryOperator.Negate)
		)
	)

	source
)

(rule 2
	(SimplifyFloat
		(NumberUnaryOperation
			inner @ (NumberUnaryOperation _ type (NumberUnaryOperator.Absolute))
			type
			(NumberUnaryOperator.Absolute)
		)
	)

	inner
)

(rule 1
	(SimplifyFloat
		(NumberUnaryOperation
			(NumberUnaryOperation source type (NumberUnaryOperator.Negate))
			type
			(NumberUnaryOperator.Absolute)
		)
	)

	(NumberUnaryOperation source type (NumberUnaryOperator.Absolute))
)
