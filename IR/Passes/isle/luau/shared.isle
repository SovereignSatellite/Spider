(type LuauUnaryOperator extern
	(enum
		(Negate)
		(Absolute)
		(SquareRoot)
		(RoundDown)
		(RoundUp)
		(RoundToZero)
		(FlipMostSignificant)
	)
)

(decl LuauUnaryOperation (Link LuauUnaryOperator) Link)
(extern extractor LuauUnaryOperation get_luau_unary_operation)

(type LuauBinaryOperator extern
	(enum
		(Minimum)
		(Maximum)
		(FloatModulo)
	)
)

(decl LuauBinaryOperation (Link Link LuauBinaryOperator) Link)
(extern extractor LuauBinaryOperation get_luau_binary_operation)

(decl pure partial EvaluateLuauUnary (LuauUnaryOperator f64) f64)
(extern constructor EvaluateLuauUnary evaluate_luau_unary)

(decl pure EvaluateLuauBinary (LuauBinaryOperator f64 f64) f64)
(extern constructor EvaluateLuauBinary evaluate_luau_binary)

(decl LuauNumber (f64) Link)
(extern extractor LuauNumber constant_luau_number)

;; Decline non-finite results and retain exact word-sized results as integers.
(decl pure partial raw_luau_number_result (f64) Link)
(extern constructor raw_luau_number_result raw_luau_number_result)
