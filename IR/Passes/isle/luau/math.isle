(decl IntegralLuauUnary (Link) Link)
(extern extractor IntegralLuauUnary get_integral_luau_unary)

(decl LuauExtremum (Link Link) Link)
(extern extractor LuauExtremum get_luau_extremum)

(decl partial SimplifyLuauMath (Link) Link)

(rule 5
	(SimplifyLuauMath
		(LuauUnaryOperation
			inner @ (LuauUnaryOperation _ (LuauUnaryOperator.Absolute))
			(LuauUnaryOperator.Absolute)
		)
	)

	inner
)

(rule 4
	(SimplifyLuauMath
		(IntegralLuauUnary inner @ (IntegralLuauUnary _))
	)

	inner
)

(rule 3
	(SimplifyLuauMath
		(LuauExtremum source source)
	)

	source
)

(rule 2
	(SimplifyLuauMath
		(LuauUnaryOperation (LuauNumber source) operator)
	)

	(raw_luau_number_result (EvaluateLuauUnary operator source))
)

(rule 1
	(SimplifyLuauMath
		(LuauBinaryOperation (LuauNumber left) (LuauNumber right) operator)
	)

	(raw_luau_number_result (EvaluateLuauBinary operator left right))
)
