)

(decl pure OptimizationEnabled (Optimization) bool)
(extern constructor OptimizationEnabled optimization_enabled)

(type LinkPair
	(enum
		(Pair (first Link) (second Link))
	)
)

(type IntegerType extern
	(enum
		(I32)
		(I64)
	)
)

