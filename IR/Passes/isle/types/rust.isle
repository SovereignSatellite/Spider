		(ReduceI64AddZero)
		(ReduceI64SubtractIdentity)
		(ReduceI64MultiplyIdentity)
		(ReduceI64AndIdentity)
		(ReduceI64OrIdentity)
		(ReduceI64ExclusiveOrIdentity)
		(ReduceI64ShiftIdentity)
		(ReduceI64RotateIdentity)
		(ReduceI64DivideOne)
		(ReduceI64RemainderOne)
		(ReduceI64DoubleNegation)
